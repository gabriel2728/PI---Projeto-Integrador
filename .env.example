# Arquivo de exemplo para configuração de ambiente
# COPIE este arquivo para .env e configure com suas credenciais reais

# Configurações do banco de dados
DB_HOST=localhost
DB_USER=seu_usuario_mysql
DB_PASS=sua_senha_mysql
DB_NAME=nome_do_banco

# E-mail (SMTP) - use uma senha de app do Gmail
SMTP_USER=seu_email@gmail.com
SMTP_PASS="sua_senha_de_app"

# development = mostra erros na tela; production = só registra no log
APP_ENV=production

# NOTA: Nunca commite o arquivo .env real no Git!
# Apenas o .env.example deve ser versionado